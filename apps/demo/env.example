# Copy to .env, then run: node --env-file=.env server.mjs
# The offline demo needs only Node >=22. Cloud analysis stays off by default.
ROBOMEMO_DEMO_PORT=8787
ROBOMEMO_ENABLE_AUTO=0
ROBOMEMO_BRIDGE_URL=http://127.0.0.1:8766
# Relative to apps/demo when started from that directory. Contains YOUR runtime state.
ROBOMEMO_BRIDGE_CONNECTION_FILE=../../services/bridge/.private-state/connection.json
# Optional alternative: supply your own pairing code at runtime, never commit it.
# ROBOMEMO_BRIDGE_PAIRING_CODE=
