# Copy to .env, then run: node --env-file=.env server.mjs
ROBOMEMO_DASHBOARD_PORT=8765
ROBOMEMO_CAPTION_PORT=8766
ROBOMEMO_ALLOW_LAN=0
# Default is .private-state beside server.mjs; never commit the created directory.
# To choose another directory, set your own private location:
# ROBOMEMO_STATE_DIR=
